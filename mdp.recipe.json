{
  "format": 1,
  "steps": [
    "$(MOCHIOS_CARGO) --manifest-path $(PROJECT)/Cargo.toml --bin mail",
    "python3 $(ROOT)/tools/devkit/build-support/package-app.py --source $(PROJECT) --binary $(RUST_TARGET_DIR)/x86_64-unknown-mochios/release/mail --mpack $(MPACK)"
  ],
  "package": {
    "name": "app-mail",
    "version": "0.1.0",
    "target": "x86_64-mochios",
    "abi": "mochios-1"
  },
  "artifact": "out/mdp/app-mail.tar.mdp",
  "exports": [
    {
      "source": "out/mdp/application/application.mpkg",
      "area": "applications",
      "destination": "mail.mpkg"
    }
  ],
  "metadata": {
    "application": {
      "source": "mail",
      "mpkg": "mail.mpkg"
    }
  }
}
